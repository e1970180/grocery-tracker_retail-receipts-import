# ==============================================================================
# retail-receipts-import: Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in the required values.
# NEVER commit `.env` or real credentials to version control.
#
# Environment variables use the `RRI_` prefix.
# Validated once at application startup using Pydantic Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Target
# ------------------------------------------------------------------------------
# Target runtime environment: 'dev' or 'prod'.
# Constraint:
#   - When 'dev', RRI_DB_NAME MUST end with '-dev' (e.g., 'grocery-tracker-dev').
#   - When 'prod', RRI_DB_NAME MUST NOT end with '-dev' (e.g., 'grocery-tracker').
RRI_ENV=dev

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Secret bot API token obtained from @BotFather.
RRI_TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to submit receipt photos/PDFs.
# Messages from users not in this list are rejected with an access-denied message.
# Example: 12345678,98765432
RRI_ALLOWED_USER_IDS=

# Telegram chat ID of the administrator where failure notifications, pipeline
# alerts, and unparseable receipt files are forwarded. The admin must send /start
# to the bot first.
RRI_ADMIN_CHAT_ID=

# Long-polling HTTP timeout in seconds for Telegram getUpdates requests. Default: 30.
RRI_TELEGRAM_POLL_TIMEOUT_S=30

# ------------------------------------------------------------------------------
# Google Gemini API & Vision Model Configuration
# ------------------------------------------------------------------------------
# Google AI Studio API key for Gemini models.
RRI_GEMINI_API_KEY=

# Gemini model identifier. Default: 'gemini-3.8-flash'.
RRI_GEMINI_MODEL=gemini-3.8-flash

# Per-request HTTP timeout in seconds for Gemini API calls. Default: 120.
RRI_GEMINI_TIMEOUT_S=120

# Reasoning / thinking level for supported Gemini models.
# Allowed values: 'minimal', 'low', 'medium', 'high'. Default: 'low'.
# Note: gemini-3.8-flash accepts 'low', 'medium', 'high'.
RRI_GEMINI_THINKING_LEVEL=low

# Exponential backoff parameters when Gemini API returns 503 / temporary unavailable
# and provides no Retry-After header.
# Initial backoff delay in seconds. Default: 600 (10 minutes).
RRI_GEMINI_BACKOFF_INITIAL_S=600
# Maximum backoff delay cap in seconds. Default: 1800 (30 minutes).
RRI_GEMINI_BACKOFF_CAP_S=1800

# Maximum image resolution (width * height in pixels). Images exceeding this
# threshold are downscaled proportionally before sending to Gemini to control costs
# and network latency without sacrificing OCR legibility. Default: 16000000 (16 MP).
RRI_IMAGE_MAX_PIXELS=16000000

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (Writer Role)
# ------------------------------------------------------------------------------
# Target PostgreSQL host (LAN IP or DNS hostname) and port.
RRI_DB_HOST=192.168.100.218
RRI_DB_PORT=5432

# Database name. Must match the RRI_ENV constraint above.
RRI_DB_NAME=grocery-tracker-dev

# Regular service writer role (e.g., 'rri_dev_writer' on the server;
# or 'rri_dev_developer' on the local development workstation).
# The writer has minimal permissions: SELECT on public.chains_v1,
# SELECT/INSERT on retail_receipts_import.receipts, and INSERT on lines/settlements/feed.
RRI_DB_USER=rri_dev_writer
RRI_DB_PASSWORD=

# Database connection timeout in seconds. Default: 10.
RRI_DB_CONNECT_TIMEOUT_S=10

# Server-side statement timeout in milliseconds to prevent runaway queries. Default: 30000 (30 s).
RRI_DB_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Database Migration Credentials (Schema Owner)
# ------------------------------------------------------------------------------
# Credentials for the schema owner role (e.g., 'rri_dev_owner' / 'rri_prod_owner').
# Only needed when running `python -m retail_receipts_import migrate`.
# On production/server deployment, pass these dynamically via `docker compose run -e`
# rather than persisting them in the server's `.env`.
RRI_MIGRATE_DB_USER=
RRI_MIGRATE_DB_PASSWORD=

# ------------------------------------------------------------------------------
# Resolver Contract Verification (Optional / Development)
# ------------------------------------------------------------------------------
# Credentials for the Resolver read-only role (e.g., 'resolver_dev_reader').
# Used exclusively by development verification scripts (e.g., scratch/verify_resolver_dev.py)
# to audit read access to resolver_v1 views and feed contract compliance.
# RRI_RESOLVER_DB_USER=resolver_dev_reader
# RRI_RESOLVER_DB_PASSWORD=

# ------------------------------------------------------------------------------
# Queue & Background Job Processing
# ------------------------------------------------------------------------------
# Delay in seconds before retrying a failed pipeline step. Default: 600 (10 minutes).
RRI_JOB_RETRY_DELAY_S=600

# Maximum attempts per job (download attempts, then pass-1 and pass-2 Gemini attempts)
# before marking the job as permanently failed. Default: 3.
RRI_JOB_MAX_ATTEMPTS=3

# Directory path where the local SQLite job queue and downloaded receipt files reside.
# In Docker compose, maps to the mounted `/data` volume.
# When running locally outside container, set to a local directory (e.g., './data').
RRI_DATA_DIR=/data

# ------------------------------------------------------------------------------
# Application Texts & Logging
# ------------------------------------------------------------------------------
# Path to TOML file containing user-facing and admin notification texts. Default: 'texts/messages.toml'.
RRI_TEXTS_PATH=texts/messages.toml

# Console logging level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'. Default: 'INFO'.
RRI_LOG_LEVEL=INFO
