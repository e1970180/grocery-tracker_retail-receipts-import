# Copy to .env and fill in. Never commit .env.
# dev needs a database name ending in -dev; prod needs one that does not.
RRI_ENV=dev
RRI_TELEGRAM_BOT_TOKEN=
RRI_GEMINI_API_KEY=
RRI_GEMINI_MODEL=gemini-3.8-flash
RRI_GEMINI_TIMEOUT_S=120
RRI_GEMINI_THINKING_LEVEL=low

RRI_DB_HOST=
RRI_DB_PORT=5432
RRI_DB_NAME=
RRI_DB_USER=
RRI_DB_PASSWORD=
RRI_DB_CONNECT_TIMEOUT_S=10
RRI_DB_STATEMENT_TIMEOUT_MS=30000

# Schema owner, used only by the migrate command. On the server pass these with
# `compose run -e` instead of keeping them in .env.
RRI_MIGRATE_DB_USER=
RRI_MIGRATE_DB_PASSWORD=

# Telegram user ids allowed to send receipts, comma-separated.
RRI_ALLOWED_USER_IDS=
# Chat id that gets failure notices and file copies; the admin must have started the bot.
RRI_ADMIN_CHAT_ID=
RRI_TELEGRAM_POLL_TIMEOUT_S=30
# Seconds before a job whose step failed runs again.
RRI_JOB_RETRY_DELAY_S=600
# Refused downloads of one file, then Gemini attempts shared by both passes, before it fails;
# the count starts again once the file is downloaded.
RRI_JOB_MAX_ATTEMPTS=3
# The compose volume; set a local directory when running outside the container.
RRI_DATA_DIR=/data

RRI_LOG_LEVEL=INFO
